{
  "name": "no-tracker-refs",
  "version": "1.0.0",
  "description": "Blocks edits and commits that add Linear ticket IDs, branch names, or MR references to code.",
  "author": {
    "name": "Daiego"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/inject-rule.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/pre-tool-guard.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
