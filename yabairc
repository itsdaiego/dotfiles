# default layout (can be bsp, stack or float)
yabai -m config layout bsp
yabai -m config window_border off
yabai -m config window_shadow off
# Keep Yabai geometry changes instant, including the Cmd+F zoom toggle.
yabai -m config window_animation_duration 0.0
yabai -m config window_opacity_duration 0.0


# new window spawns to the right if vertical split, or bottom if horizontal split
yabai -m config window_placement second_child

# The top bar occupies the existing top gap; release the old bottom-bar gap
# so tiled windows extend down into that recovered space.
yabai -m config top_padding 0
yabai -m config bottom_padding 8

yabai -m config left_padding 10
yabai -m config right_padding 10
yabai -m config window_gap 15

# -- mouse settings --

# center mouse on window with focus
yabai -m config mouse_follows_focus on

# modifier for clicking and dragging with mouse
yabai -m config mouse_modifier alt
# set modifier + left-click drag to move window
yabai -m config mouse_action1 move
# set modifier + right-click drag to resize window
yabai -m config mouse_action2 resize

# when window is dropped in center of another window, swap them (on edges it will split it)
yabai -m mouse_drop_action swap


# disable specific apps
yabai -m rule --add app="^System Settings$" manage=off
yabai -m rule --add app="^Calculator$" manage=off
yabai -m rule --add app="^Karabiner-Elements$" manage=off
yabai -m rule --add app="^QuickTime Player$" manage=off

# Assign Spaces 1-2 to the first display and Spaces 3-4 to the second display.
# The helper is a no-op while only the MacBook display is connected.
yabai -m signal --remove label=assign-monitor-spaces-display-added 2>/dev/null
yabai -m signal --remove label=assign-monitor-spaces-display-removed 2>/dev/null
yabai -m signal --remove label=assign-monitor-spaces-system-woke 2>/dev/null
yabai -m signal --add event=display_added label=assign-monitor-spaces-display-added action="$HOME/.local/bin/yabai-assign-monitor-spaces"
yabai -m signal --add event=display_removed label=assign-monitor-spaces-display-removed action="$HOME/.local/bin/yabai-assign-monitor-spaces"
yabai -m signal --add event=system_woke label=assign-monitor-spaces-system-woke action="$HOME/.local/bin/yabai-assign-monitor-spaces"

# The Denis Erdogan SketchyBar profile recalculates its height and Yabai top
# reservation from the current monitor count whenever displays change.
yabai -m signal --remove label=sketchybar-layout-display-added 2>/dev/null
yabai -m signal --remove label=sketchybar-layout-display-removed 2>/dev/null
yabai -m signal --remove label=sketchybar-layout-system-woke 2>/dev/null
yabai -m signal --add event=display_added label=sketchybar-layout-display-added action="$HOME/.config/sketchybar/themes/deniserdogan/reload-for-display-change.sh"
yabai -m signal --add event=display_removed label=sketchybar-layout-display-removed action="$HOME/.config/sketchybar/themes/deniserdogan/reload-for-display-change.sh"
yabai -m signal --add event=system_woke label=sketchybar-layout-system-woke action="$HOME/.config/sketchybar/themes/deniserdogan/reload-for-display-change.sh"

# Reload the scripting addition whenever Dock restarts. This requires the
# matching passwordless sudoers rule for the current yabai binary.
yabai -m signal --remove label=load-yabai-scripting-addition 2>/dev/null
yabai -m signal --add event=dock_did_restart label=load-yabai-scripting-addition action="sudo /opt/homebrew/bin/yabai --load-sa"
"$HOME/.local/bin/yabai-assign-monitor-spaces" >/dev/null 2>&1 &
# Re-apply the monitor-aware SketchyBar geometry on every Yabai restart.
"$HOME/.config/sketchybar/themes/deniserdogan/reload-for-display-change.sh" >/dev/null 2>&1 &
