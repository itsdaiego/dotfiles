#!/bin/sh
# SketchyBar profile loader. The selected profile is the only mutable state.
PROFILE_FILE="$HOME/.config/sketchybar/current_profile"
PROFILE="classic"
[ -r "$PROFILE_FILE" ] && PROFILE="$(tr -d '[:space:]' < "$PROFILE_FILE")"

case "$PROFILE" in
  classic)       source "$HOME/.config/sketchybar/themes/classic.sh" ;;
  reference)     source "$HOME/.config/sketchybar/themes/rice-reference/sketchybarrc" ;;
  deniserdogan)  source "$HOME/.config/sketchybar/themes/deniserdogan/layout.sh" ;;
  *)
    echo "Unknown SketchyBar profile '$PROFILE'; loading classic." >&2
    source "$HOME/.config/sketchybar/themes/classic.sh"
    ;;
esac
